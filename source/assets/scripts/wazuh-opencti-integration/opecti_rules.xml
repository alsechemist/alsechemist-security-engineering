  <!-- =========================================================
       OBSERVABLE_ONLY MATCH TIER — match_type=observable_only
       Same structure as indicator_hit_valid: IOC type primary,
       score tiers nested. Sequential rule IDs 300044 onwards,
       four tiers per type:
         baseline (catches anything not matching score regexes)
         LOW    score 0-49
         MEDIUM score 50-79
         HIGH   score 80-100

       NOTE: observable_only means OpenCTI has the value as a stored
       observable but no active (non-revoked, non-expired) Indicator
       backs it. Operationally a tier below indicator_hit_valid - the
       value was tracked but not currently weaponized as a detection.
       Group tags include opencti_match_observable for downstream
       deprioritization if your SIEM/SOAR uses tag-based routing.
       ========================================================= -->

  <!-- 300044 — PARENT: any observable_only hit. Baseline level 15
       ensures unknown IOC types still alert. All branches chain off this. -->
       
  <rule id="300044" level="15">
    <if_sid>300000</if_sid>
    <field name="match_type">observable_only</field>
    <description>OpenCTI: Threat intel matched OBSERVABLES on $(ioc.type) $(ioc.value) [score=$(severity_score)]</description>
    <group>opencti_match,opencti_match_observable,</group>
  </rule>

  <!-- =========================================================
       FILE HASH BRANCH — sha256, sha1, md5 (observable_only)
       ========================================================= -->

  <!-- 300045 — file hash baseline -->
  
