<group name="opencti,threat_intel,">

  <!-- =========================================================
       BASE: every opencti enrichment event lands here first
       ========================================================= -->
  <rule id="300000" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">opencti</field>
    <description>OpenCTI enrichment event (base)</description>
  </rule>
  
  <!-- =========================================================
       OPENCTI PLATFORM LOGS — auth, API errors, audit
       ========================================================= -->
  
  <rule id="300001" level="3">
    <if_sid>300000</if_sid>
    <field name="match_type">error</field>
    <description>OpenCTI: $(error_message)</description>
    <group>opencti_match_error,</group>
  </rule>
  
  <!-- AUTH_REQUIRED — token invalid, expired, revoked, or missing.
       This is operationally critical: TI pipeline is BLIND until fixed.
       The script will keep retrying every alert, so this is also self-amplifying. -->
       

  <!-- Base: any enrichment lookup that failed at the platform layer -->
       
  <rule id="300002" level="10">
    <if_sid>300001</if_sid>
    <field name="error_message" type="pcre2">"code":\s*"AUTH_REQUIRED"</field>
    <description>OpenCTI: AUTH FAILURE - API token rejected (HTTP 401). System - Threat intel enrichment is offline.</description>
    <group>authentication_failed,opencti_auth_failure,opencti_pipeline_down,</group>
  </rule>
  
    <!-- Persistant auth failure → escalate to incident-level.
       Three failures in 5 minutes means it's not a transient blip. -->
       
  <rule id="300003" level="10" frequency="3" timeframe="300">
    <if_matched_sid>300002</if_matched_sid>
    <description>OpenCTI: PERSISTENT AUTH FAILURE - threat intel pipeline DOWN, immediate action required</description>
    <group>opencti_pipeline_down,incident,</group>
  </rule>
  
    <!-- FORBIDDEN — token valid but lacks permission for the operation.
       Often means RBAC misconfiguration after a role change. -->
       
  <rule id="300004" level="7">
    <if_sid>300000</if_sid>
    <field name="error_message" type="pcre2">"(code|http_status)":\s*("FORBIDDEN"|403)</field>
    <description>OpenCTI: PERMISSION DENIED - token lacks rights to query indicators/observables (HTTP 403)</description>
    <group>opencti_permission_denied,</group>
  </rule>

  <!-- Rate limiting / quota — if your script gets throttled, you're flying blind -->
  
  <rule id="300005" level="7">
    <if_sid>300004</if_sid>
    <field name="error_message" type="pcre2">"http_status":\s*429|rate.?limit|too many requests</field>
    <description>OpenCTI: RATE LIMITED (HTTP 429) - lookups for $(ioc.value) being throttled</description>
    <group>opencti_rate_limited,</group>
  </rule>
  
  <!-- 5xx — platform is broken or overloaded -->
  
  <rule id="300006" level="10">
    <if_sid>300000</if_sid>
    <field name="error_message" type="pcre2">"http_status":\s*5\d{2}|"genre":\s*"TECHNICAL".*("INTERNAL|TIMEOUT|UNAVAILABLE")</field>
    <description>OpenCTI: PLATFORM ERROR (5xx) - server-side fault during lookup</description>
    <group>opencti_platform_5xx,</group>
  </rule>

  <!-- Sustained 5xx → platform outage -->
  
  <rule id="300007" level="12" frequency="5" timeframe="600">
    <if_matched_sid>300006</if_matched_sid>
    <description>OpenCTI: PLATFORM OUTAGE - sustained server errors, threat intel unavailable</description>
    <group>opencti_pipeline_down,incident,</group>
  </rule>
  
    <!-- Connection / network failures (script couldn't reach platform at all).
       Pattern matches errors that don't carry an http_status — usually DNS, TCP, TLS, timeout. -->
       
  <rule id="300008" level="10">
    <if_sid>300000</if_sid>
    <field name="error_message" type="pcre2">(?i)(connection refused|timed out|name or service not known|ssl|tls|unreachable|connection reset)</field>
    <description>OpenCTI: NETWORK FAILURE reaching platform - $(error_message)</description>
    <group>opencti_network_error,</group>
  </rule>

  <!-- Catch-all for anything else returning match_type=error -->
  <!-- Inherits level 7 from 110260; this child just adds an audit trail group -->
  
  <rule id="300009" level="7">
    <if_sid>300000</if_sid>
    <field name="error_message" type="pcre2">.+</field>
    <description>OpenCTI: LOOKUP ERROR - (uncategorized) - $(error_message)</description>
    <group>opencti_error_other,</group>
  </rule>
  
    <!-- =========================================================
       NON-MATCH TIER (informational / noise floor)
       ========================================================= -->

  <!-- IOC checked but not in OpenCTI — useful for visibility, low level -->
  
  <rule id="300010" level="3">
    <if_sid>300000</if_sid>
    <field name="match_type">no_match</field>
    <description>OpenCTI: No intel match for $(ioc.type) $(ioc.value)</description>
    <group>opencti_no_match,</group>
  </rule>
  
   <!-- =========================================================
       MATCH TIER — indicator_hit_valid
       Structure: IOC-type is primary axis, score tiers nested under each.
       Each event walks ONE path: parent -> type branch -> score sub-tier.
       Sequential rule IDs 300011 onwards, four tiers per type:
         baseline (catches anything not matching score regexes)
         LOW    score 0-49
         MEDIUM score 50-79
         HIGH   score 80-100
       ========================================================= -->

  <!-- 300011 — PARENT: any valid indicator hit. Baseline level 15
       ensures unknown IOC types still critical alert. All branches chain off this. -->
       
  <rule id="300011" level="15">
    <if_sid>300000</if_sid>
    <field name="match_type">indicator_hit_valid</field>
    <description>OpenCTI: Threat intel matched INDICATORS on $(ioc.type) $(ioc.value) [score=$(severity_score)]</description>
    <group>opencti_match,opencti_indicator_match</group>
  </rule>

  <!-- =========================================================
       FILE HASH BRANCH — sha256, sha1, md5
       Most actionable: a hash hit means THAT EXACT FILE is on the host
       ========================================================= -->

  <!-- 300012 — file hash baseline -->
  
  <rule id="300012" level="15">
    <if_sid>300011</if_sid>
    <field name="ioc.type" type="pcre2">^(sha256|sha1|md5)$</field>
    <description>OpenCTI: malicious FILE HASH matched INDICATORS on $(source_agent_name) - $(ioc.type)=$(ioc.value) [score=$(severity_score)]</description>
    <group>opencti_match_hash,</group>
  </rule>

  <!-- 300013 — file hash, LOW confidence (0-49) -->
  
  <rule id="300013" level="15">
    <if_sid>300012</if_sid>
    <field name="severity_score" type="pcre2">^([0-9]|[1-4][0-9])$</field>
    <description>OpenCTI: LOW-confidence FILE HASH matched INDICATORS on $(source_agent_name) - $(ioc.type)=$(ioc.value) [score=$(severity_score)]</description>
    <group>opencti_match_hash,opencti_match_low,</group>
  </rule>

  <!-- 300014 — file hash, MEDIUM confidence (50-79) -->
  
  <rule id="300014" level="15">
    <if_sid>300012</if_sid>
    <field name="severity_score" type="pcre2">^([5-7][0-9])$</field>
    <description>OpenCTI: MEDIUM-confidence FILE HASH matched INDICATORS on $(source_agent_name) - $(ioc.type)=$(ioc.value) [score=$(severity_score)]</description>
    <group>opencti_match_hash,opencti_match_medium,</group>
  </rule>

  <!-- 300015 — file hash, HIGH confidence (80-100) -->
  
